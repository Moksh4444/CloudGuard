# CloudGuard Platform Configuration
PROJECT_NAME="CloudGuard — Cloud Security & Network Troubleshooting Platform"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DATABASE_URL="sqlite:///./cloudguard.db"

# SSRF Security Boundaries (strictly False by default)
ALLOW_PRIVATE_IPS=False

# Diagnostic timeouts & bounding
DEFAULT_TIMEOUT_SECONDS=6.0
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=1048576
TRACEROUTE_MAX_HOPS=15
TRACEROUTE_TIMEOUT_SECONDS=10
